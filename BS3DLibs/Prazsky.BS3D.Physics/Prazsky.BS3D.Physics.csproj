<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--ContactEvents is an unsafe class and NarrowPhaseCallbacks an unsafe struct: both are adapted from the
        BepuPhysics demos, which reach into the solver's raw manifold pointers.-->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
    <PackageReference Include="BepuUtilities" />
    <!--Compile-time only, see Prazsky.Core.csproj-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prazsky.BS3D\Prazsky.BS3D.csproj" />
  </ItemGroup>

  <!--BallsConstraintsBuilder.DestroyBall, the one-ball removal the storey cut replaced (#692), is kept for the tests that
      need exactly one ball out of a lattice-->
  <ItemGroup>
    <InternalsVisibleTo Include="BS3D.Tests" />
  </ItemGroup>

</Project>
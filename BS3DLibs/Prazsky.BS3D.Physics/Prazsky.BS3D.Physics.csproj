<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--ContactEvents is an unsafe class and NarrowPhaseCallbacks an unsafe struct: both are adapted from the
        BepuPhysics demos, which reach into the solver's raw manifold pointers.-->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <PackageReference Include="BepuUtilities" Version="2.5.0-beta.29" />
    <!--Compile-time only, see Prazsky.Core.csproj-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Prazsky.BS3D\Prazsky.BS3D.csproj" />
  </ItemGroup>

</Project>
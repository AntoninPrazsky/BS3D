<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Authors></Authors>
    <Description></Description>
    <PackageTags>monogame input event based listeners</PackageTags>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>NU1701</NoWarn>
    <AssemblyName>Prazsky.Core</AssemblyName>
    <RootNamespace>Prazsky.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <PackageReference Include="BepuUtilities" Version="2.5.0-beta.29" />
    <!--Compile-time only: both MonoGame platform packages ship the same MonoGame.Framework assembly,
        so keeping this private lets each executable pick its own backend (Testbed WindowsDX, MapEditor
        DesktopGL) without the two packages colliding over the same output file.-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" PrivateAssets="all" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <Authors></Authors>
    <Description></Description>
    <PackageTags>monogame input event based listeners</PackageTags>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl></RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>NU1701</NoWarn>
    <AssemblyName>Prazsky.Core</AssemblyName>
    <RootNamespace>Prazsky.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <PackageReference Include="BepuUtilities" Version="2.5.0-beta.29" />
    <!--Compile-time only: both MonoGame platform packages ship an assembly named MonoGame.Framework, so
        keeping this private stops it reaching any executable's output folder and lets each of them pick its
        own backend (all three are WindowsDX today). An executable must reference exactly ONE of the two —
        two of them is not a build error, NuGet just picks a winner for the output folder, and if that is not
        the backend the content was compiled for the exe dies on its first effect. See Game.csproj.-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" PrivateAssets="all" />
  </ItemGroup>
</Project>
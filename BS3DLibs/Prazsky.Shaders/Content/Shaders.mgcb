# The Potato tier's effects, for the Windows build's "potato" run (#808): the Raspberry Pi's picture on a desktop.
# The SOURCES are GamePi's - GamePi/Shaders, where compile.ps1 builds them for OpenGL and commits the result - and here
# the same files are compiled for DirectX 11 (PotatoProfile.fxh names the profiles for each). They land under
# Content/Potato/Shaders, apart from the desktop's, because six of the nine have a desktop effect of the same name:
# the Game's content manager looks under Content/Potato first when the run is a Potato one (PotatoContent), and
# nowhere near it otherwise. The second path of each /build is that destination.

#begin ../../../GamePi/Shaders/PotatoModel.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../../GamePi/Shaders/PotatoModel.fx;Potato/Shaders/PotatoModel.fx

#begin ../../../GamePi/Shaders/PotatoSky.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../../GamePi/Shaders/PotatoSky.fx;Potato/Shaders/PotatoSky.fx

#begin ../../../GamePi/Shaders/PotatoUpscale.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../../GamePi/Shaders/PotatoUpscale.fx;Potato/Shaders/PotatoUpscale.fx



#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)/Content
/intermediateDir:obj/$(Platform)
/platform:Windows
/config:
/profile:HiDef
/compress:False

#-------------------------------- References --------------------------------#

#---------------------------------- Content ---------------------------------#

# Everything here is built straight out of the Testbed's content directory, so there is one copy of each
# shader, texture and dome in the repository and a change reaches every executable at once (the map editor
# does the same). Nothing in this project has content of its own yet.

# The island's stone. This is the texture the Testbed's GroundMarble model carries; the Testbed loads the
# whole model and fishes the texture out of its BasicEffect because it also used to draw the model, while
# the island only ever wanted the image — so it is built here directly as a Texture2D.
#begin ../../Testbed/Content/GameObjects/Ground_8.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=0,0,0,0
/processorParam:ColorKeyEnabled=False
/processorParam:GenerateMipmaps=True
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Compressed
/build:../../Testbed/Content/GameObjects/Ground_8.png;GameObjects/Ground_8.png

# The overlay's font (FPS). The same description the Testbed's overlay uses, so the two read alike.
#begin ../../Testbed/Content/Fonts/segoeui.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/build:../../Testbed/Content/Fonts/segoeui.spritefont;Fonts/segoeui.spritefont

#begin ../../Testbed/Content/Shaders/InstancedModel.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../Testbed/Content/Shaders/InstancedModel.fx;Shaders/InstancedModel.fx

#begin ../../Testbed/Content/Shaders/Glare.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../Testbed/Content/Shaders/Glare.fx;Shaders/Glare.fx

#begin ../../Testbed/Content/Shaders/Tonemap.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../Testbed/Content/Shaders/Tonemap.fx;Shaders/Tonemap.fx

#begin ../../Testbed/Content/Shaders/ShotTrail.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../Testbed/Content/Shaders/ShotTrail.fx;Shaders/ShotTrail.fx

#begin ../../Testbed/Content/Shaders/Sky.fx
/importer:EffectImporter
/processor:EffectProcessor
/processorParam:DebugMode=Auto
/build:../../Testbed/Content/Shaders/Sky.fx;Shaders/Sky.fx

#begin ../../Testbed/Content/Skyes/SkyDome13.dae
/importer:XImporter
/processor:ModelProcessor
/processorParam:ColorKeyColor=0,0,0,0
/processorParam:ColorKeyEnabled=True
/processorParam:DefaultEffect=BasicEffect
/processorParam:GenerateMipmaps=True
/processorParam:GenerateTangentFrames=False
/processorParam:PremultiplyTextureAlpha=True
/processorParam:PremultiplyVertexColors=True
/processorParam:ResizeTexturesToPowerOfTwo=False
/processorParam:RotationX=0
/processorParam:RotationY=0
/processorParam:RotationZ=0
/processorParam:Scale=1
/processorParam:SwapWindingOrder=False
/processorParam:TextureFormat=Compressed
/build:../../Testbed/Content/Skyes/SkyDome13.dae;Skyes/SkyDome13.dae


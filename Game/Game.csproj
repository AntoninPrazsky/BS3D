<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>BS3D.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BS3D</AssemblyName>
    <RootNamespace>BS3D</RootNamespace>
    <Copyright>Antonín Pražský</Copyright>
    <PackageIcon>Icon.ico</PackageIcon>
    <PackageIconUrl />
    <UseWindowsForms>True</UseWindowsForms>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <MonoGameContentReference Include="**\*.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Content\bin\**" />
    <Compile Remove="Content\obj\**" />
    <EmbeddedResource Remove="Content\bin\**" />
    <EmbeddedResource Remove="Content\obj\**" />
    <MonoGameContentReference Remove="Content\bin\**" />
    <MonoGameContentReference Remove="Content\obj\**" />
    <None Remove="Content\bin\**" />
    <None Remove="Content\obj\**" />
    <Content Include="Icon.ico" />
    <None Include="Icon.ico">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
    <PackageReference Include="BepuUtilities" Version="2.5.0-beta.29" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.6" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5" />
    <PackageReference Include="Myra" Version="1.6.3" />
  </ItemGroup>

  <!--The menu UI's fonts (Myra renders through FontStashSharp, which needs TTF bytes at runtime). Inter is
  SIL OFL 1.1, so redistribution is permitted; Segoe UI (the InfoRenderer's spritefont source) is not. Embedded
  so no on-disk path has to exist at runtime and nothing flows through the MGCB content pipeline.-->
  <ItemGroup>
    <EmbeddedResource Include="Content\Fonts\Inter-Regular.ttf" />
    <EmbeddedResource Include="Content\Fonts\Inter-Bold.ttf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D.Physics\Prazsky.BS3D.Physics.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D\Prazsky.BS3D.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.Core\Prazsky.Core.csproj" />
  </ItemGroup>
</Project>

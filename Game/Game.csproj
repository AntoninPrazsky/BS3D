<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <!--The shipped build has no console (#570): a console subsystem exe opens a window beside the game on
    every player's launch, closing it kills the game without an unload, and with QuickEdit on one click in it
    blocks the next Console.WriteLine and freezes the frame. Release is what release.yml publishes; a Debug
    build keeps the console it is developed with. Either way every line also goes to the run log (RunLog).-->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <StartupObject>BS3D.Program</StartupObject>
    <AssemblyName>BS3D</AssemblyName>
    <RootNamespace>BS3D</RootNamespace>
    <Copyright>Antonín Pražský</Copyright>
    <UseWindowsForms>True</UseWindowsForms>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!--Which release this build is (#546). release.yml passes the tag as BS3DReleaseVersion on a tag build and
  only then, and it becomes an assembly attribute the online client reads: a build that carries it may submit to
  the built-in score service, and any other build - a local one, a rehearsal zip - submits only to a server its
  settings name, so a developer's runs never land on the public boards. A property rather than a guess from the
  version number, because a local build's default 1.0.0 and a suffixed tag's are indistinguishable from it.-->
  <ItemGroup Condition="'$(BS3DReleaseVersion)' != ''">
    <AssemblyMetadata Include="BS3DReleaseVersion" Value="$(BS3DReleaseVersion)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <MonoGameContentReference Include="**\*.mgcb" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Content\bin\**" />
    <Compile Remove="Content\obj\**" />
    <EmbeddedResource Remove="Content\bin\**" />
    <EmbeddedResource Remove="Content\obj\**" />
    <MonoGameContentReference Remove="Content\bin\**" />
    <MonoGameContentReference Remove="Content\obj\**" />
    <None Remove="Content\bin\**" />
    <None Remove="Content\obj\**" />
    <Content Include="Icon.ico" />
    <None Include="Icon.ico">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
    <PackageReference Include="BepuUtilities" />
    <PackageReference Include="FontStashSharp.MonoGame" />
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <!--Exactly ONE MonoGame platform package, and it has to be the one Content.mgcb builds for. Both packages
    ship an assembly named MonoGame.Framework.dll, so referencing both is an error nowhere in the build: NuGet
    quietly picks one of them for the output folder, and it picked DesktopGL. Everything compiled with zero
    warnings and the exe died on its first Load<Effect> with "This MGFX effect was built for a different
    platform!" — the content is /platform:Windows (DX11, SM 5.0) and an OpenGL runtime cannot read an MGFX
    header stamped DirectX. The libraries reference the other package PrivateAssets="all" so it stops at the
    compile and never reaches here; see Prazsky.Core.csproj.-->
    <PackageReference Include="MonoGame.Framework.WindowsDX" />
    <PackageReference Include="Myra" />
    <!--The music's decoder (#444, MIT): Game/Music is Ogg Vorbis, decoded to PCM at load by Audio/OggTrack.cs.
    Tools/MusicBake compiles that file too and reads the same version from Directory.Packages.props, so what it measures is what plays.-->
    <PackageReference Include="NVorbis" />
  </ItemGroup>

  <!--The menu UI's fonts (Myra renders through FontStashSharp, which needs TTF bytes at runtime). Anton sets
  everything meant to be loud (the title, the menu entries, the HUD) and Inter the small print under it, and
  PromptFont (#189, v1.15, shinmera.com/promptfont) draws the tutorial's keycaps, mouse buttons and gamepad
  triggers - glyphs rather than bitmaps, so they scale with the HUD and nothing goes through the content
  pipeline for them. All three are SIL OFL 1.1, so redistribution is permitted and each ships with its
  licence beside it; Segoe UI (the InfoRenderer's spritefont source) is not, and neither is Impact, which is
  why the Impact look is Anton. Embedded so no on-disk path has to exist at runtime and nothing flows through
  the MGCB content pipeline.-->
  <ItemGroup>
    <EmbeddedResource Include="Content\Fonts\Anton-Regular.ttf" />
    <EmbeddedResource Include="Content\Fonts\Inter-Regular.ttf" />
    <EmbeddedResource Include="Content\Fonts\Inter-Bold.ttf" />
    <EmbeddedResource Include="Content\Fonts\PromptFont.ttf" />
  </ItemGroup>
  <!--The levels and the set that orders them. Plain files copied beside the exe rather than MGCB content:
  they are data the game reads with System.Text.Json at runtime, not assets the pipeline compiles, and keeping
  them editable next to the binary is the point — a level can be swapped without a rebuild.-->
  <ItemGroup>
    <Content Include="Levels\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--The music (#443), for the same reason: Ogg Vorbis files (#444) GameMusic decodes into the PCM buffers it
  submits itself, which a pipeline SoundEffect would never hand back. Written by Tools/MusicBake's tracks mode from
  the masters in Research/AI-Music; a track or an Ember variant can be replaced by dropping a file here.-->
  <ItemGroup>
    <Content Include="Music\*.ogg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--The generated sound effects (#482): Ogg Vorbis files ProceduralAudio decodes at load and puts through its bakes'
  own loudness law and voices; a file that is missing leaves the procedural bake standing. Written by Tools/MusicBake's
  sfx mode from a render the owner chose; a sound is replaced by dropping a file here.-->
  <ItemGroup>
    <Content Include="Sfx\*.ogg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D.Physics\Prazsky.BS3D.Physics.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D\Prazsky.BS3D.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.Core\Prazsky.Core.csproj" />
  </ItemGroup>
</Project>

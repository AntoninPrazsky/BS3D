<Project Sdk="Microsoft.NET.Sdk">
  <!--The Game, built for Android phones on MonoGame's Android backend - OpenGL ES for the picture (#1047, #1048). Like
  GamePi it is NOT a second game: it compiles Game/'s own sources and owns only what cannot be shared:

  - this project file (net10.0-android, the Android package instead of WindowsDX, no WinForms);
  - MainActivity, the app's one activity, which takes the place of Program.Main (it calls Program.Start, then creates
    and runs the game, since on Android Run returns at once);
  - Platform/, the namesakes of the Windows-only files of Game/Platform, as GamePi has them;
  - AssetFiles, the APK's assets as the files the Game ships beside its executable (#1049): every reader goes through
    Prazsky.Core's ShippedFiles, and this answers it from the assets.

  It draws through the desktop's renderer with every shared effect compiled for OpenGL ES (#1057), at a phone's tiers
  (#1060, PhoneTiers), and through the Potato path with GamePi's nine SM 3.0 effects when Potato is chosen on the
  Quality row; both sets are built here from their sources (below). Its other content (the logo, the HUD's
  font) is GamePi's Content.mgcb built for Android.

  Needs the Android workload (dotnet workload install android), the Android SDK (found in %LOCALAPPDATA%\Android\Sdk)
  and JDK 17, named with -p:JavaSdkDirectory=... on the command line. No solution names it yet, so building the
  others needs no Android tools.-->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <!--The Game's own names: the player's profile, the run log and the online client read these, and an assembly
    called anything else would be a different game to all three.-->
    <AssemblyName>BS3D</AssemblyName>
    <RootNamespace>BS3D</RootNamespace>
    <Copyright>Antonín Pražský</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--The app's identity on a phone and in a store: never changed once a player has it, or the new app cannot update
    the old one. The owner's other Android game is io.github.antoninprazsky.tw3d.-->
    <ApplicationId>io.github.antoninprazsky.bs3d</ApplicationId>
    <ApplicationTitle>BS3D</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableMGCBItems>false</EnableMGCBItems>
    <!--As in GamePi (#787): a Windows-only .NET API reached from a shared Game/ file is an error here.-->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
    <!--CoreCLR, not Mono (#1048): measured on the vivo X300 Ultra in Girandole (1204 balls) at 3168x1440, Mono held about
    42 FPS (28 to 38 with shots falling) and the same at 720 rows, so the CPU, where CoreCLR held the display's 60 with shots
    (Cabinet too). Mono offers no AdvSimd, and Bepu is written for the desktop's JIT. .NET 10 still calls CoreCLR on Android
    experimental (warning XA1040), so a fault that looks like the runtime is checked against UseMonoRuntime=true first.-->
    <UseMonoRuntime>false</UseMonoRuntime>
    <NoWarn>$(NoWarn);XA1040</NoWarn>
    <!--An APK and nothing else. The SDK's Release default is "aab;apk", and with the bundle as the main format its Install
    target (_DeployAppBundle) UNINSTALLS the app before installing it, and on the vivo X300 Ultra that took the player's
    save, settings and nickname with it (2026-11-10). The APK's install (_DeployApk) is "adb install -r", which keeps them.
    The release ships the APK anyway; a store bundle, if ever, is a decision of its own.-->
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>

  <ItemGroup Condition="'$(BS3DReleaseVersion)' != ''">
    <AssemblyMetadata Include="BS3DReleaseVersion" Value="$(BS3DReleaseVersion)" />
  </ItemGroup>

  <!--Every source of the Game but the Platform files this project replaces: GamePi's list, less QualityLock (the phone
  picks its tier as the desktop does, #1060), and with DeviceHeat (the phone's thermal status) and GpuCaps (what its
  OpenGL ES offers, #1064).-->
  <ItemGroup>
    <Compile Include="..\Game\**\*.cs"
             Exclude="..\Game\bin\**;..\Game\obj\**;..\Game\Content\bin\**;..\Game\Content\obj\**;..\Game\Platform\AudioBackend.cs;..\Game\Platform\CrashDialog.cs;..\Game\Platform\DeviceHeat.cs;..\Game\Platform\GpuCaps.cs;..\Game\Platform\DisplayRefresh.cs;..\Game\Platform\KeyboardLights.cs;..\Game\Platform\PadMotors.cs;..\Game\Platform\TargetDiscard.cs;..\Game\Platform\WindowIcon.cs"
             LinkBase="Game" />
    <Compile Include="*.cs;Platform\**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>

  <!--GamePi's content build and every shared effect's (#1057), for Android: the builds for each runtime run in parallel, so
  each gets its own folder. Prazsky.Shaders' Shaders.mgcb compiles the desktop's effects for OpenGL ES to Content/Shaders
  and the Potato path's nine to Content/Potato/Shaders, where PotatoContent looks first on a Potato run - so the phone
  compiles from the sources GamePi's committed nine are built from, on Windows, as MojoShader needs.-->
  <ItemGroup>
    <MonoGameContentReference Include="..\GamePi\Content\Content.mgcb" Link="Content\Content.mgcb" OutputFolder="$(MSBuildProjectName)$(RuntimeIdentifier)" />
    <MonoGameContentReference Include="..\BS3DLibs\Prazsky.Shaders\Content\Shaders.mgcb" Link="Content\Shaders.mgcb" OutputFolder="$(MSBuildProjectName)$(RuntimeIdentifier)" />
  </ItemGroup>

  <!--What the effects' build leaves for the phone to fix (#1057), after it and before the effects are packed:

  - MonoGame writes "precision mediump float;" at the head of every OpenGL ES pixel program, and an Adreno (the X300
    Ultra's 840 among them) computes mediump in 16-bit floats: ten bits of mantissa, so a world position past 1024 units
    is two units coarse and every noise field, the float hash (Noise.fxh) and the lighting with them come apart. The
    desktop's effects are raised to highp, the same line at the same length, so nothing else in the file moves. The
    Potato path's nine keep mediump: written for it, and measured at it on the phone.
  - MojoShader writes the side a pixel is on (VFACE, FRONT_FACE in ShaderTarget.fxh) as a global initialised from
    gl_FrontFacing, which desktop GL takes and OpenGL ES 1.00 refuses ("non-constant global initializer"): the phone's
    driver failed every program with one, the acacia's first (#1059). It becomes a #define of the same expression.
  - A GL program that indexes two uniform arrays reads each from the other's slots (GamePi/Shaders/compile.ps1, which
    refuses the same for the committed nine), and one with an integer or boolean uniform reads it as zero: MonoGame's GL
    runtime uploads only float vectors, and Shader Model 3.0 keeps a loop's uniform count in an integer register, so the
    loop never runs (the tonemap's supersample box came out black). So is a static const array read at a computed index:
    MojoShader makes it a uniform, and the savanna's flames read zeros (#1063). So is a matrix a program reads in part:
    MojoShader keeps only the registers it reads, MonoGame copies the whole matrix and throws past the end of the program's
    uniforms on the first draw (every bomb crashed the phone, #1063). A build that makes any of these fails here, which is
    what makes CI say so; so does a desktop effect left at mediump.-->
  <UsingTask TaskName="FinishGlEffects" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Raise ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Check ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        //Each rewrite the same length as what it replaces, so the lengths the effect file records around the text stay true
        string[][] rewrites =
        {
            new[] { "precision mediump float;", "precision highp float;  " },
            new[] { "float ps_vFace = gl_FrontFacing ? 1.0 : -1.0;", "#define ps_vFace (gl_FrontFacing?1.0:-1.0)   " },
        };
        int raised = 0;
        foreach (ITaskItem item in Raise)
        {
            byte[] bytes = File.ReadAllBytes(item.ItemSpec);
            int found = 0;
            foreach (string[] rewrite in rewrites)
            {
                byte[] from = Encoding.ASCII.GetBytes(rewrite[0]);
                byte[] to = Encoding.ASCII.GetBytes(rewrite[1]);
                for (int i = 0; i <= bytes.Length - from.Length; i++)
                {
                    int j = 0;
                    while (j < from.Length && bytes[i + j] == from[j]) j++;
                    if (j < from.Length) continue;
                    Array.Copy(to, 0, bytes, i, to.Length);
                    i += from.Length - 1;
                    found++;
                }
            }
            if (found > 0)
            {
                //With the time the content build wrote: it rebuilds an output whose time is not the one it recorded, so
                //a raised file would be compiled again on the next build, every effect every time
                DateTime written = File.GetLastWriteTimeUtc(item.ItemSpec);
                File.WriteAllBytes(item.ItemSpec, bytes);
                File.SetLastWriteTimeUtc(item.ItemSpec, written);
                raised++;
            }

            //What the file now says, whether it was raised now or by an earlier build: a MonoGame that writes the line
            //otherwise would leave every program at mediump and this task with nothing to do, silently
            string raisedText = Encoding.GetEncoding(28591).GetString(bytes);
            if (!raisedText.Contains("precision highp float;  ") || raisedText.Contains("precision mediump float"))
                Log.LogError(Path.GetFileName(item.ItemSpec) + " has a pixel program not raised to highp: the line MonoGame writes is no longer \"precision mediump float;\"");
            if (raisedText.Contains("ps_vFace ="))
                Log.LogError(Path.GetFileName(item.ItemSpec) + " initialises ps_vFace at global scope in a form this task does not rewrite: OpenGL ES 1.00 refuses it");
        }
        if (raised > 0) Log.LogMessage(MessageImportance.High, "GL effects: " + raised + " finished for OpenGL ES");

        foreach (ITaskItem item in Check)
        {
            string text = Encoding.GetEncoding(28591).GetString(File.ReadAllBytes(item.ItemSpec));
            string[] programs = text.Split(new[] { "#ifdef GL_ES" }, StringSplitOptions.None);
            for (int p = 1; p < programs.Length; p++)
            {
                string[] bases = Regex.Matches(programs[p], @"#define ARRAYBASE_\d+ \d+").Cast<Match>().Select(m => m.Value).Distinct().ToArray();
                if (bases.Length > 1)
                    Log.LogError(Path.GetFileName(item.ItemSpec) + ", program " + p + " indexes " + bases.Length + " uniform arrays (" + string.Join("; ", bases) + "): pack them into one under OPENGL (see Blast.fx)");
                Match table = Regex.Match(programs[p], @"uniform vec4 [vp]s_const_array_\w+");
                if (table.Success)
                    Log.LogError(Path.GetFileName(item.ItemSpec) + ", program " + p + " declares " + table.Value + ": a static const array read at a computed index, which MonoGame never fills (pick its entries at constant indices under OPENGL, see Flame.fx)");
                Match integer = Regex.Match(programs[p], @"uniform [bi]vec4 \w+");
                if (integer.Success)
                    Log.LogError(Path.GetFileName(item.ItemSpec) + ", program " + p + " declares " + integer.Value + ", which MonoGame never uploads: a loop to a uniform count runs no times (ARRAY_LOOP or COUNT_LOOP, ShaderTarget.fxh)");
            }
        }

        //⚠ A uniform MonoGame copies past the end of its program's uniforms (#1063). MojoShader keeps only the registers a
        //program reads, so a matrix read in part (a bone's .xyz, a projection's _11 and _22) is shorter there than the whole
        //matrix ConstantBuffer.SetParameter copies into it, and the first EffectPass.Apply throws ArgumentException: every
        //level with a bomb crashed on the phone. Read off each effect as MonoGame 3.8.5's Effect.ReadEffect reads it.
        (int Registers, int End) Footprint(int cls, int rows, int columns, List<(int Registers, int End)> elements)
        {
            if (elements.Count > 0)
            {
                int registers = 0, end = 0;
                foreach (var element in elements)
                {
                    end = Math.Max(end, registers * 16 + element.End);
                    registers += element.Registers;
                }
                return (registers, end);
            }
            //SetParameter: a matrix goes as ColumnCount rows of RowCount, anything else as RowCount rows of ColumnCount
            int n = cls == 2 ? columns : rows, m = cls == 2 ? rows : columns;
            if (n == 1 && m == 1) return (n, 4);
            if (n == 1 || (n == 4 && m == 4)) return (n, n * m * 4);
            return (n, 16 * (n - 1) + m * 4);
        }
        List<(int Registers, int End, string Name)> ReadParameters(BinaryReader r)
        {
            var list = new List<(int Registers, int End, string Name)>();
            int count = r.ReadInt32();
            for (int i = 0; i < count; i++)
            {
                int cls = r.ReadByte(), type = r.ReadByte();
                string name = r.ReadString();
                r.ReadString();
                if (r.ReadInt32() != 0) throw new InvalidDataException("an annotation");
                int rows = r.ReadByte(), columns = r.ReadByte();
                var elements = ReadParameters(r);
                var members = ReadParameters(r);
                bool data = elements.Count == 0 && members.Count == 0;
                if (data && type >= 1 && type <= 3) r.ReadBytes(rows * columns * 4);
                var footprint = members.Count > 0 && elements.Count == 0 ? (0, 0)
                    : Footprint(cls, rows, columns, elements.Select(e => (e.Registers, e.End)).ToList());
                list.Add((footprint.Item1, footprint.Item2, name));
            }
            return list;
        }
        foreach (ITaskItem item in Check)
        {
            byte[] fx = File.ReadAllBytes(item.ItemSpec);
            int start = -1;
            for (int i = 0; i + 4 <= fx.Length && start < 0; i++)
                if (fx[i] == 'M' && fx[i + 1] == 'G' && fx[i + 2] == 'F' && fx[i + 3] == 'X') start = i;
            if (start < 0) continue;
            int version = fx[start + 4];
            using var r = new BinaryReader(new MemoryStream(fx, start + 10, fx.Length - start - 10));
            int bufferCount = r.ReadInt32();
            var sizes = new int[bufferCount];
            var placed = new List<(int Index, int Offset)>[bufferCount];
            var users = new List<string>[bufferCount];
            for (int b = 0; b < bufferCount; b++)
            {
                r.ReadString();
                sizes[b] = r.ReadInt16();
                placed[b] = new List<(int, int)>();
                users[b] = new List<string>();
                int members = r.ReadInt32();
                for (int k = 0; k < members; k++) placed[b].Add((r.ReadInt32(), r.ReadUInt16()));
            }
            int shaderCount = r.ReadInt32();
            var programs = new List<(string Entry, string Code, List<byte> Buffers)>();
            for (int s = 0; s < shaderCount; s++)
            {
                r.ReadBoolean();
                string entry = "";
                if (version > 10) { r.ReadString(); entry = r.ReadString(); }
                int length = r.ReadInt32();
                string code = Encoding.GetEncoding(28591).GetString(r.ReadBytes(length));
                int samplers = r.ReadByte();
                for (int k = 0; k < samplers; k++)
                {
                    r.ReadBytes(3);
                    if (r.ReadBoolean()) r.ReadBytes(20);
                    r.ReadString();
                    r.ReadByte();
                }
                int buffers = r.ReadByte();
                var bufferIds = new List<byte>();
                for (int k = 0; k < buffers; k++) { byte b = r.ReadByte(); bufferIds.Add(b); users[b].Add(entry); }
                int attributes = r.ReadByte();
                for (int k = 0; k < attributes; k++) { r.ReadString(); r.ReadBytes(4); }
                programs.Add((entry, code, bufferIds));
            }
            var parameters = ReadParameters(r);

            //⚠ A register never read in the MIDDLE of a parameter (#1063, the glass's pink slab and the motion blur's tiles).
            //MojoShader's GLSL maps each D3D register the program reads to the next slot of its uniform array
            //("#define ps_c31 ps_uniforms_vec4[30]"), and MonoGame fills the array by the layout of whole parameters, so a
            //skipped register puts every uniform after it one slot late. A skipped register shows as a jump in the register
            //numbers against consecutive slots; an indexed array is placed first and jumps the other way, which is not one.
            foreach (var program in programs)
            {
                var defines = Regex.Matches(program.Code, @"#define (?:vs|ps)_c(\d+) (?:vs|ps)_uniforms_vec4\[(\d+)\]").Cast<Match>()
                    .Select(m => (Register: int.Parse(m.Groups[1].Value), Slot: int.Parse(m.Groups[2].Value))).OrderBy(d => d.Register).ToList();
                //The whole of it first: the GLSL's array has a slot per register read, the block a register per parameter's
                //register, and the two agree in every program without a hole (314 of 314 on 2026-11-09); the walk below then
                //names the parameter when the hole is between two reads
                Match declared = Regex.Match(program.Code, @"uniform vec4 (?:vs|ps)_uniforms_vec4\[(\d+)\]");
                int blockRegisters = program.Buffers.Sum(b => sizes[b]) / 16;
                if (declared.Success && int.Parse(declared.Groups[1].Value) != blockRegisters)
                    Log.LogError(Path.GetFileName(item.ItemSpec) + ": " + program.Entry + " declares " + declared.Groups[1].Value + " uniform registers where its block holds "
                        + blockRegisters + ": a register of a parameter is never read, so under GL every uniform after it arrives one slot late (#1063):"
                        + " read the register with KEEP_READ (ShaderTarget.fxh), see Glass.fxh");
                for (int k = 0; k + 1 < defines.Count; k++)
                {
                    if (defines[k + 1].Register - defines[k].Register <= 1 || defines[k + 1].Slot - defines[k].Slot != 1) continue;
                    int hole = defines[k].Slot + 1;
                    string owner = "a parameter";
                    foreach (byte b in program.Buffers)
                        foreach (var (index, offset) in placed[b])
                            if (offset / 16 <= hole && hole < offset / 16 + parameters[index].Registers)
                                owner = parameters[index].Name + " (register " + (hole - offset / 16) + " of its " + parameters[index].Registers + ")";
                    Log.LogError(Path.GetFileName(item.ItemSpec) + ": " + program.Entry + " never reads " + owner + ", so under GL every uniform after it arrives"
                        + " one slot late (MojoShader gives the program's array a slot per register READ, MonoGame fills it by whole parameters, #1063):"
                        + " read the register with KEEP_READ (ShaderTarget.fxh), see Glass.fxh");
                    break;
                }
            }
            for (int b = 0; b < bufferCount; b++)
                foreach (var (index, offset) in placed[b])
                    if (offset + parameters[index].End > sizes[b])
                        Log.LogError(Path.GetFileName(item.ItemSpec) + ": " + parameters[index].Name + " is copied to byte " + (offset + parameters[index].End)
                            + " of a " + sizes[b] + "-byte uniform block (" + string.Join(", ", users[b].Distinct()) + "), and MonoGame throws on its first draw:"
                            + " the program reads the matrix in part, so MojoShader keeps only some of its registers (read all four columns under OPENGL, see BallBomb.fxh)");
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="FinishGlEffects" AfterTargets="RunContentBuilder" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GlEffects>$(MSBuildThisFileDirectory)..\BS3DLibs\Prazsky.Shaders\Content\bin\$(MonoGamePlatform)\$(MSBuildProjectName)$(RuntimeIdentifier)</_GlEffects>
    </PropertyGroup>
    <ItemGroup>
      <_GlRaise Include="$(_GlEffects)\Shaders\*.xnb" />
      <_GlCheck Include="$(_GlEffects)\**\*.xnb" />
    </ItemGroup>
    <FinishGlEffects Raise="@(_GlRaise)" Check="@(_GlCheck)" />
  </Target>

  <!--The levels, the music and the sound effects, packed at the asset root under the paths the Game reads them from
  beside its executable, as Content/ already is: AssetFiles answers a path under the base directory with the asset at
  the same relative path, read in place (#1049).-->
  <ItemGroup>
    <AndroidAsset Include="..\Game\Levels\**\*.json" Exclude="..\Game\Levels\Prototypes\**" Link="Assets\Levels\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="..\Game\Music\*.ogg" Link="Assets\Music\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\Game\Music\Drums\*.ogg" Link="Assets\Music\Drums\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\Game\Sfx\*.ogg" Link="Assets\Sfx\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--The menu's fonts, embedded under the names the Game's LoadEmbeddedFont asks for, as in GamePi.-->
  <ItemGroup>
    <EmbeddedResource Include="..\Game\Content\Fonts\Anton-Regular.ttf" Link="Content\Fonts\Anton-Regular.ttf" LogicalName="BS3D.Content.Fonts.Anton-Regular.ttf" />
    <EmbeddedResource Include="..\Game\Content\Fonts\Inter-Regular.ttf" Link="Content\Fonts\Inter-Regular.ttf" LogicalName="BS3D.Content.Fonts.Inter-Regular.ttf" />
    <EmbeddedResource Include="..\Game\Content\Fonts\Inter-Bold.ttf" Link="Content\Fonts\Inter-Bold.ttf" LogicalName="BS3D.Content.Fonts.Inter-Bold.ttf" />
    <EmbeddedResource Include="..\Game\Content\Fonts\PromptFont.ttf" Link="Content\Fonts\PromptFont.ttf" LogicalName="BS3D.Content.Fonts.PromptFont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
    <PackageReference Include="BepuUtilities" />
    <PackageReference Include="FontStashSharp.MonoGame" />
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <PackageReference Include="MonoGame.Framework.Android" />
    <PackageReference Include="Myra" />
    <PackageReference Include="NVorbis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D.Physics\Prazsky.BS3D.Physics.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D\Prazsky.BS3D.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.Core\Prazsky.Core.csproj" />
  </ItemGroup>
</Project>

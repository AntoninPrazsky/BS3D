<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <!--GamePi: the Game's spritefont with Inter in place of Segoe UI, which Linux does not have (see Content.mgcb).-->
  <Asset Type="Graphics:FontDescription">
    <FontName>../../../Game/Content/Fonts/Inter-Regular.ttf</FontName>
    <Size>48</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#x20;</Start>
        <End>&#x7E;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#xA0;</Start>
        <End>&#xFF;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x100;</Start>
        <End>&#x17F;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
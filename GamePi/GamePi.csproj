<Project Sdk="Microsoft.NET.Sdk">
  <!--The Game, built for Linux ARM64 (a Raspberry Pi 5) on MonoGame DesktopGL - SDL2 for the window and the input,
  OpenAL Soft for the sound, OpenGL for the picture. It is NOT a second game: it owns no gameplay, no screen and no
  rule, and compiles Game/'s own sources. What it owns is what cannot be shared:

  - this project file (net10.0 instead of net10.0-windows, the DesktopGL package instead of WindowsDX, no WinForms);
  - Platform/, the few classes whose Windows implementation is nothing but Win32 or WinForms, and QualityLock, the
    tier the build is held at (Potato, #788). Each is a file of Game/Platform left out of the compile below and
    replaced here by one with the same name and the same members;
  - Content/Content.mgcb, because the Game's builds a "Segoe UI" spritefont, which no Linux machine has.

  Game.csproj does not know this project exists, so the Windows build is the one it was. A change to Game/ reaches
  both; WinForms added to a shared file fails this build, and so does any other Windows-only .NET API (CA1416, made
  an error below), which is the point of building it - build.yml builds it on an ARM64 runner on every push (#787).
  A DllImport into user32 is invisible to both and fails only when it runs.

  The shaders are its own (#789). Every effect in Prazsky.Shaders is Shader Model 5.0, and DesktopGL compiles through
  MojoShader, which stops at 3.0 - so this project references no Prazsky.Shaders, and the Potato tier draws with a
  small set of SM 3.0 effects in Shaders/. Those cannot be compiled on the Pi either (mgfxc needs the Windows D3D
  compiler), so they are compiled on Windows (Shaders/compile.ps1, and gamepi-shaders.yml on every push that touches
  them) and the compiled .xnb are committed in Shaders/Compiled, which this project only copies.-->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>BS3D.Program</StartupObject>
    <!--The Game's own names: the player's profile, the run log and the online client read these, and an assembly
    called anything else would be a different game to all three.-->
    <AssemblyName>BS3D</AssemblyName>
    <RootNamespace>BS3D</RootNamespace>
    <Copyright>Antonín Pražský</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--The Game's sources live one directory up; nothing under this folder is globbed by default except Platform/.-->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!--The content task would otherwise glob every .mgcb under this folder, Shaders/Shaders.mgcb included, and compiling
    an effect off Windows needs Wine (MGFXC0001): those are compiled by Shaders/compile.ps1 and committed (#789). The
    one content build this project runs is named below.-->
    <EnableMGCBItems>false</EnableMGCBItems>
    <!--A Windows-only .NET API reached from a shared Game/ file is a build error here, not a warning (#787): a warning
    in a build nobody watches is a crash on the Pi found weeks later. It is what found InternetCheck's COM call (#786);
    the Windows build is net10.0-windows and never sees it.-->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <!--Which release this build is, exactly as in Game.csproj (#546): release.yml passes the tag, and a build without
  one submits only to a server its settings name.-->
  <ItemGroup Condition="'$(BS3DReleaseVersion)' != ''">
    <AssemblyMetadata Include="BS3DReleaseVersion" Value="$(BS3DReleaseVersion)" />
  </ItemGroup>

  <!--Every source of the Game but the Windows-only Platform files this project replaces. A file named here must
  have its namesake in Platform/; a new Win32 or WinForms file in Game/Platform belongs on this list too.-->
  <ItemGroup>
    <Compile Include="..\Game\**\*.cs"
             Exclude="..\Game\bin\**;..\Game\obj\**;..\Game\Content\bin\**;..\Game\Content\obj\**;..\Game\Platform\AudioBackend.cs;..\Game\Platform\CrashDialog.cs;..\Game\Platform\DisplayRefresh.cs;..\Game\Platform\QualityLock.cs;..\Game\Platform\WindowIcon.cs" />
    <Compile Include="Platform\**\*.cs" />
  </ItemGroup>

  <!--The Potato tier's OpenGL effects, compiled on Windows and committed (see the comment at the top), copied to
  Content/Shaders where Load<Effect>("Shaders/...") looks - the same place Prazsky.Shaders puts the Windows build's.-->
  <ItemGroup>
    <Content Include="Shaders\Compiled\*.xnb" Link="Content\Shaders\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <None Remove="Content\bin\**" />
    <None Remove="Content\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
    <PackageReference Include="BepuUtilities" />
    <PackageReference Include="FontStashSharp.MonoGame" />
    <PackageReference Include="MonoGame.Content.Builder.Task" />
    <!--The one MonoGame platform package, as Game.csproj insists: both ship an assembly named MonoGame.Framework, and
    two of them make NuGet pick one silently.-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="Myra" />
    <PackageReference Include="NVorbis" />
  </ItemGroup>

  <!--The menu's fonts, embedded under the names the Game's LoadEmbeddedFont asks for (the Link is what makes the
  manifest name BS3D.Content.Fonts.<file> for a file outside this folder).-->
  <ItemGroup>
    <EmbeddedResource Include="..\Game\Content\Fonts\Anton-Regular.ttf" Link="Content\Fonts\Anton-Regular.ttf" />
    <EmbeddedResource Include="..\Game\Content\Fonts\Inter-Regular.ttf" Link="Content\Fonts\Inter-Regular.ttf" />
    <EmbeddedResource Include="..\Game\Content\Fonts\Inter-Bold.ttf" Link="Content\Fonts\Inter-Bold.ttf" />
    <EmbeddedResource Include="..\Game\Content\Fonts\PromptFont.ttf" Link="Content\Fonts\PromptFont.ttf" />
  </ItemGroup>

  <!--The levels, the music and the sound effects: the Game's own files, copied beside the binary at the paths the
  Game reads them from.-->
  <ItemGroup>
    <Content Include="..\Game\Levels\**\*.json" Link="Levels\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="..\Game\Levels\Prototypes\**" CopyToPublishDirectory="Never" />
    <Content Include="..\Game\Music\*.ogg" Link="Music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Game\Music\Drums\*.ogg" Link="Music\Drums\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Game\Sfx\*.ogg" Link="Sfx\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D.Physics\Prazsky.BS3D.Physics.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.BS3D\Prazsky.BS3D.csproj" />
    <ProjectReference Include="..\BS3DLibs\Prazsky.Core\Prazsky.Core.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BS3D.Tests</AssemblyName>
    <RootNamespace>BS3D.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1701;CS1574</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <!--Compile-time only, exactly as Tools/LevelGen takes it and for its reason: the tests need Vector3 and
        the types the libraries expose, never a graphics backend. Nothing here opens a window or a device, so
        the project stays plain net10.0 like the libraries it tests.-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" PrivateAssets="all" />
    <!--Bepu is referenced directly because the constraint and attach tests build a Simulation of their own,
        the way Tools/LevelGen/SagProbe does; the version is the libraries' own.-->
    <PackageReference Include="BepuPhysics" />
    <PackageReference Include="BepuUtilities" />
    <!--The Vorbis decoder the game ships (#726): OggTrack.cs below is compiled in, as Tools/MusicBake compiles it.-->
    <PackageReference Include="NVorbis" />
  </ItemGroup>

  <!--The chapter-intro shot builders, compiled in from the Game (#645): they are plain geometry over
      TerrainMirror's height fields — no device, no window — and the Game is net10.0-windows, which this project
      is not. Tools/MusicBake takes Game/Audio the same way. IntroShotSmoothnessTests builds the terrain-hugging
      shots through their own code and holds their ride to a limit.-->
  <ItemGroup>
    <Compile Include="..\..\Game\Effects\IntroShot.cs" />
    <Compile Include="..\..\Game\Effects\IntroPaths.cs" />
    <Compile Include="..\..\Game\Effects\AridIntroPaths.cs" />
    <Compile Include="..\..\Game\Effects\MountainIntroShots.cs" />
    <Compile Include="..\..\Game\Effects\DesertIntroShots.cs" />
    <Compile Include="..\..\Game\Effects\VolcanoIntroShots.cs" />
  </ItemGroup>

  <!--The tutorial's rules (#666), compiled in the same way: Tutorial is a ladder of lessons and clocks with no device
      in it. TutorialTests walks the shipped level set through it and holds which chapter teaches what.-->
  <ItemGroup>
    <Compile Include="..\..\Game\Screens\Tutorial.cs" />
    <Compile Include="..\..\Game\Screens\TutorialCardLayout.cs" />
    <!--The power-up chips' keycap column (#694): arithmetic over measured widths, no device.-->
    <Compile Include="..\..\Game\Screens\ChipColumnLayout.cs" />
    <Compile Include="..\..\Game\Screens\NavWalk.cs" />
    <!--The paragraph breaker (#769, #806): lines broken at spaces only, for the paragraph's shape, over a measure handed
        in; and the copy's characters held to the typesetting rules.-->
    <Compile Include="..\..\Game\Screens\SpaceWrap.cs" />
    <Compile Include="..\..\Game\Screens\CopyRules.cs" />
    <!--Tabular figures by hand (#806): every digit in a cell as wide as the widest, as space commands a label lays out,
        over a face's ten advances handed in-->
    <Compile Include="..\..\Game\Screens\TabularFigures.cs" />
    <!--What the level picker, the boards and the result page say (#806): strings only, held to those rules-->
    <Compile Include="..\..\Game\Screens\PickerCopy.cs" />
    <Compile Include="..\..\Game\Screens\LevelResult.cs" />
    <Compile Include="..\..\Game\Screens\ScoreText.cs" />
    <!--What the About page says (#807): strings only, held to those rules and to the credits it must keep.-->
    <Compile Include="..\..\Game\Screens\AboutCopy.cs" />
    <Compile Include="..\..\Game\Screens\FieldTail.cs" />
    <!--A checkbox's tick (#816): which part of each row of pixels two round-ended strokes cover, no device.-->
    <Compile Include="..\..\Game\Screens\CheckTick.cs" />
    <!--The aim ghost's beat (#831): its size as a pure function of the wall clock, no device.-->
    <Compile Include="..\..\Game\Screens\GhostBeat.cs" />
    <!--The overview lens's tilt with the aim (#720): its target, the gun-keep limit and its chase, plain geometry and a
        closed-form follow over floats, no device.-->
    <Compile Include="..\..\Game\Screens\AimTilt.cs" />
    <!--The ceiling's descent and the player's brake on it (#213): a state machine over floats, no device.-->
    <Compile Include="..\..\Game\Screens\CeilingDescent.cs" />
    <!--The city intro's shot builder (#488): plain geometry over City's block grid.-->
    <Compile Include="..\..\Game\Effects\CityIntroShots.cs" />
    <!--What a nickname may be, and which words are secret (#548, #230): a string rule with no device in it.-->
    <Compile Include="..\..\Game\Online\Nickname.cs" />
    <!--The first-launch nickname question (#763): when it is asked, what an Esc on it counts for, the field's editing and
        the three-state setting through its file. Plain values and a JSON file, no device.-->
    <Compile Include="..\..\Game\Online\NicknamePrompt.cs" />
    <Compile Include="..\..\Game\Screens\NicknameEntry.cs" />
    <Compile Include="..\..\Game\GameSettings.cs" />
    <Compile Include="..\..\Game\QualityLevel.cs" />
    <!--#495: the drums layer's mix, pure arithmetic over 16-bit buffers-->
    <Compile Include="..\..\Game\Audio\DrumLayer.cs" />
    <!--#811: the aim stop's creak and puff, pure arithmetic whose spectrum the tests measure-->
    <Compile Include="..\..\Game\Audio\AimStopSynth.cs" />
    <!--#845: the streak break's falling run, pure arithmetic whose spectrum the tests measure, and the rules of when the
        break is told and when the Swap chip points at the cure-->
    <Compile Include="..\..\Game\Audio\StreakBreakSynth.cs" />
    <Compile Include="..\..\Game\Screens\StreakCues.cs" />
    <!--#726: the blue ceiling step's bake, and the game's own Ogg decoder and FFT, so the tests measure the shipped
        recording decoded the way the game loads it, and the red step's beside it-->
    <Compile Include="..\..\Game\Audio\CeilingFeedSynth.cs" />
    <Compile Include="..\..\Game\Audio\OggTrack.cs" />
    <Compile Include="..\..\Game\Audio\Spectrum.cs" />
    <!--And how far up its pour a blue step is played (#726), on the frame seconds the descent lets steps go by-->
    <Compile Include="..\..\Game\Audio\CeilingFeedPour.cs" />
    <!--#846: the award popup's zoom, read and throw as pure functions of its age and points, and the HUD's eases under it-->
    <Compile Include="..\..\Game\Screens\AwardZoom.cs" />
    <Compile Include="..\..\Game\Screens\HudEase.cs" />
    <!--#810: the landing's rumble by the count released, and the pad mixer's own channel (its accumulation under a
        ceiling and its decay), pure arithmetic over floats-->
    <Compile Include="..\..\Game\LandingRumble.cs" />
    <Compile Include="..\..\Game\PadChannel.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.BS3D\Prazsky.BS3D.csproj" />
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.Core\Prazsky.Core.csproj" />
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.BS3D.Physics\Prazsky.BS3D.Physics.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DocDrift</AssemblyName>
    <RootNamespace>BS3D.Tools.DocDrift</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--No project references and no MonoGame: this tool reads the tree's source files and the documents as
      text. It knows nothing of the game's types, so it builds and runs anywhere .NET does.-->
</Project>

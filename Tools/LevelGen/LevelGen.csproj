<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LevelGen</AssemblyName>
    <RootNamespace>BS3D.Tools.LevelGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--Compile-time only, exactly as the libraries take it and for the same reason (see
        Prazsky.Core.csproj): this tool needs Vector3 and the types the libraries expose, not a
        graphics backend. It draws nothing and opens no window — it is plain net10.0, so it also runs
        anywhere the libraries build rather than only on Windows.-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.BS3D\Prazsky.BS3D.csproj" />
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.Core\Prazsky.Core.csproj" />
    <!--The sag gate (SagProbe, #301/#302) hangs a level in the REAL simulation rather than reading its
        layout, which is the only instrument that has ever found this class of fault — see that file's own
        doc. Bepu needs no graphics device either, so the tool stays a plain net10.0 console app that draws
        nothing and opens no window.-->
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.BS3D.Physics\Prazsky.BS3D.Physics.csproj" />
  </ItemGroup>
</Project>

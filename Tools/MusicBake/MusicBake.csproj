<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MusicBake</AssemblyName>
    <RootNamespace>BS3D.Tools.MusicBake</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--The one source file the procedural compositions live in, compiled INTO this tool rather than referenced
        through the Game project. The bakes are pure arithmetic over float arrays - they touch no graphics device,
        no audio device and no content - so pulling them in as source keeps this a plain net10.0 console app that
        builds in a second and renders the same samples the About page plays, from the same lines. A
        ProjectReference to Game.csproj would drag WinForms, the MGCB content build and a Windows target framework
        behind a tool that writes audio files.-->
    <Compile Include="..\..\Game\Audio\ProceduralMusic.cs" />
    <!--A streamed render's progress (#464): ProceduralMusic.Render takes one, so the type has to be in scope
        to compile even though this tool always passes null and never touches it.-->
    <Compile Include="..\..\Game\Audio\RenderProgress.cs" />
    <!--The fade the fanfare in that file walks, and the FFT this tool's band table shares with the About page's
        visualizer: plain arithmetic too, each in a file of its own only because the game shares it.-->
    <Compile Include="..\..\Game\Audio\MusicFade.cs" />
    <Compile Include="..\..\Game\Audio\Spectrum.cs" />
    <!--The game's own track decoder (#444), so the tracks mode decodes every file it has just encoded the way the
        game will, and its length and loop-edge checks are about what actually plays.-->
    <Compile Include="..\..\Game\Audio\OggTrack.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--Compile-time only, exactly as ScoreSim and the libraries take it: ProceduralMusic.cs names MathHelper
        and the SoundEffect types in its playback half, and this tool calls neither - it renders and measures.
        PrivateAssets keeps the package from flowing anywhere, and DesktopGL is deliberate: nothing here loads
        an MGFX effect, so the platform of the package is irrelevant and the tool stays buildable off Windows.-->
    <PackageReference Include="MonoGame.Framework.DesktopGL" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--The Vorbis decoder the game ships (the one version Directory.Packages.props pins for both, which OggTrack.cs is written against) and
        the encoder only this tool needs: a managed port of libvorbis, MIT like NVorbis, so writing an .ogg needs
        nothing installed on the machine.-->
    <PackageReference Include="NVorbis" />
    <PackageReference Include="OggVorbisEncoder" />
  </ItemGroup>
</Project>

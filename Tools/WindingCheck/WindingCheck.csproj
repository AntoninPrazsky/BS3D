<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>WindingCheck</AssemblyName>
    <RootNamespace>BS3D.Tools.WindingCheck</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--Unlike the other tools this one needs a real MonoGame backend, because it runs the procedural meshes'
      own constructors and those upload straight into GPU buffers. It asks DirectX for WARP, the software
      rasteriser every Windows install carries, so no GPU is touched and no window is ever shown - but it
      is therefore Windows-only, like the three executables.-->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.BS3D\Prazsky.BS3D.csproj" />
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.Core\Prazsky.Core.csproj" />
    <!--Every compiled effect (#618): the library compiles the shaders once and its .xnb files are copied into
        this project's Content/Shaders. Its assembly is empty, so it is not referenced (and not copied).-->
    <ProjectReference Include="..\..\BS3DLibs\Prazsky.Shaders\Prazsky.Shaders.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

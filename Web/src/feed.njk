---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title }}: the blog</title>
  <subtitle>How a bubble shooter in three dimensions is made.</subtitle>
  <link rel="self" type="application/atom+xml" href="{{ site.url }}/feed.xml"/>
  <link rel="alternate" type="text/html" href="{{ site.url }}/blog/"/>
  <id>{{ site.url }}/blog/</id>
  <updated>{{ (collections.posts | last).date | isoDate }}</updated>
  <author>
    <name>{{ site.author }}</name>
    <uri>{{ site.authorUrl }}</uri>
  </author>
{%- for post in collections.posts | reverse %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link rel="alternate" type="text/html" href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | isoDate }}</published>
    <updated>{{ post.date | isoDate }}</updated>
    <summary>{{ post.data.summary }}</summary>
    <content type="html">{{ post.templateContent | absoluteLinks }}</content>
  </entry>
{%- endfor %}
</feed>
